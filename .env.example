# SMTP settings (Teleemon currently uses Titan mailboxes)
# Use the MAILBOX password for this address — not your hosting account login.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@teleemon.com
SMTP_PASS=REPLACE_WITH_MAILBOX_PASSWORD

# If 465 auth fails, switch to STARTTLS on 587:
# SMTP_PORT=587
# SMTP_SECURE=false

# If you move to Hostinger native mail later, use:
# SMTP_HOST=smtp.hostinger.com

# Where requests are delivered
MAIL_TO=info@teleemon.com
MAIL_FROM=info@teleemon.com
